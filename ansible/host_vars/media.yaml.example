#   op inject -i media.yaml.example -o media.yaml
---
ansible_host: "{{op://Private/Proxmox-T620-Media/ip}}"
ansible_become_password: "{{op://Private/Proxmox-T620-Media/password}}"
ansible_user: "{{op://Private/Proxmox-T620-Media/user}}"

media_plex_x_plex_token: "{{op://Shared/Plex/X-Plex-Token}}"

media_delugevpn_wireguard_private_key: "{{op://Private/Mullvad-VPN/wireguard-private-key-3}}"
media_delugevpn_wireguard_address: "{{op://Private/Mullvad-VPN/wireguard-addresses-3}}"
media_delugevpn_wireguard_dns: "{{op://Private/Mullvad-VPN/wireguard-dns-3}}"
media_delugevpn_wireguard_peer_public_key: "{{op://Private/Mullvad-VPN/wireguard-public-key-3}}"
media_delugevpn_wireguard_endpoint: "{{op://Private/Mullvad-VPN/wireguard-endpoint-3}}"
media_delugevpn_lan_network: "192.168.20.0/24, 192.168.1.0/24"

packages_list:
  - podman
  - tree

